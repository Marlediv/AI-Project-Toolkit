# EditorConfig helps maintain consistent basic formatting across editors,
# IDEs, contributors, and AI-assisted development tools.
#
# Project-specific formatter configuration should take precedence where
# a language or framework requires more specific formatting rules.
#
# Documentation:
# https://editorconfig.org/

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false